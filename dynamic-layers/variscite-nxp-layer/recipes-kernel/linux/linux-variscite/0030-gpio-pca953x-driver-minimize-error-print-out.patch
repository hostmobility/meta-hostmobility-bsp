From c25328a2571c2b02914477982231bab91ddca891 Mon Sep 17 00:00:00 2001
From: OpenEmbedded <oe.patch@oe>
Date: Tue, 21 Apr 2026 12:08:12 +0200
Subject: [PATCH 1/1] gpio: pca953x: restore suspend/resume on HMX

Re-enable the PM ops disabled in "gpio: pca953x: Disable PM routines" and
fix the two things that made them useless on imx8mp-var-dart-hmx1:

 - Reinstate the disable_irq()/enable_irq() pair from upstream 3e38f946062b
   ("gpio: pca953x: fix IRQ storm on system wake up"), dropped when the
   lf-6.6.52-2.2.1 merge kept NXP's LF-14048 rework over it. Without it the
   threaded handler spins on failing reads during wake up - the "failed
   reading register" flood this patch used to suppress.

 - Sync the register cache on resume unconditionally. LF-14048 gated it on
   chip->regulator, which is NULL here (no vcc-supply), so the pca9535 came
   back in reset state with every pin an input and the LEDs stayed dark.

Also initialise ret in pca953x_resume() and propagate regulator_enable()
failures. The error_count hack is replaced by dev_err_ratelimited(), which
does not report success from pca953x_read_regs() with an unfilled bitmap,
nor sleep 25ms inside chip->i2c_lock.

diff --git a/drivers/gpio/gpio-pca953x.c b/drivers/gpio/gpio-pca953x.c
index 0ff4e7118a78..df4dfd090be5 100644
--- a/drivers/gpio/gpio-pca953x.c
+++ b/drivers/gpio/gpio-pca953x.c
@@ -493,7 +493,8 @@ static int pca953x_write_regs(struct pca953x_chip *chip, int reg, unsigned long

 	ret = regmap_bulk_write(chip->regmap, regaddr, value, NBANK(chip));
 	if (ret < 0) {
-		dev_err(&chip->client->dev, "failed writing register\n");
+		/* Expander stops acking in super cap mode; don't flood. */
+		dev_err_ratelimited(&chip->client->dev, "failed writing register\n");
 		return ret;
 	}

@@ -508,7 +509,7 @@ static int pca953x_read_regs(struct pca953x_chip *chip, int reg, unsigned long *

 	ret = regmap_bulk_read(chip->regmap, regaddr, value, NBANK(chip));
 	if (ret < 0) {
-		dev_err(&chip->client->dev, "failed reading register\n");
+		dev_err_ratelimited(&chip->client->dev, "failed reading register\n");
 		return ret;
 	}

@@ -1284,6 +1285,13 @@ static int pca953x_suspend(struct device *dev)
 {
 	struct pca953x_chip *chip = dev_get_drvdata(dev);

+	/*
+	 * Upstream 3e38f946062b, lost in the LF-14048 merge: without this the
+	 * threaded handler spins on failing reads during wake up.
+	 */
+	if (chip->client->irq > 0)
+		disable_irq(chip->client->irq);
+
 	/*
 	 * Only enable cache when regulator exist, if no
 	 * regulator, power keeps on, can also handle
@@ -1309,35 +1317,44 @@ static int pca953x_suspend(struct device *dev)
 static int pca953x_resume(struct device *dev)
 {
 	struct pca953x_chip *chip = dev_get_drvdata(dev);
-	int ret;
+	int ret = 0;

 	if (!atomic_read(&chip->wakeup_path) && chip->regulator) {
 		ret = regulator_enable(chip->regulator);
 		if (ret) {
 			dev_err(dev, "Failed to enable regulator: %d\n", ret);
-			return 0;
+			goto out;
 		}
 	}

-	if (chip->regulator) {
-		mutex_lock(&chip->i2c_lock);
+	mutex_lock(&chip->i2c_lock);
+
+	if (chip->regulator)
 		regcache_cache_only(chip->regmap, false);
-		regcache_mark_dirty(chip->regmap);
-		ret = pca953x_regcache_sync(dev);
-		if (ret) {
-			mutex_unlock(&chip->i2c_lock);
-			return ret;
-		}

-		ret = regcache_sync(chip->regmap);
+	/*
+	 * Unconditional: with no "vcc-supply" chip->regulator is NULL, and the
+	 * expander would come back in reset state with every pin an input.
+	 */
+	regcache_mark_dirty(chip->regmap);
+
+	ret = pca953x_regcache_sync(dev);
+	if (ret) {
 		mutex_unlock(&chip->i2c_lock);
-		if (ret) {
-			dev_err(dev, "Failed to restore register map: %d\n", ret);
-			return ret;
-		}
+		goto out;
 	}

-	return 0;
+	ret = regcache_sync(chip->regmap);
+	mutex_unlock(&chip->i2c_lock);
+	if (ret)
+		dev_err(dev, "Failed to restore register map: %d\n", ret);
+
+out:
+	/* Balances the disable_irq() in pca953x_suspend(). */
+	if (chip->client->irq > 0)
+		enable_irq(chip->client->irq);
+
+	return ret;
 }
 #endif

@@ -1402,9 +1419,7 @@ static SIMPLE_DEV_PM_OPS(pca953x_pm_ops, pca953x_suspend, pca953x_resume);
 static struct i2c_driver pca953x_driver = {
 	.driver = {
 		.name	= "pca953x",
-#if 0
 		.pm	= &pca953x_pm_ops,
-#endif
 		.of_match_table = pca953x_dt_ids,
 		.acpi_match_table = pca953x_acpi_ids,
 	},
--
2.34.1

