From dc57dee6bf15783cf41b8b3d3d14e380004f8993 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Albin=20S=C3=B6derqvist?= <albin@albinutils.se>
Date: Mon, 14 Sep 2026 13:28:44 +0200
Subject: [PATCH 3/3] rtc: pcf85063: recover invalid Control_1 when setting
 time
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A non-zero readback of the read-zero bits in Control_1 provides an
unambiguous indication that the register contents are invalid. When
setting the time, a trusted replacement time is already available, so
recover the RTC before programming it if such corruption is detected.

After updating the time, read Control_1 back and verify that the
read-zero bits, 12_24, STOP and EXT_TEST are all clear. If the
expected state was not established, issue a software reset and retry
the complete time update once. Return -EIO if the control state is
still unexpected after the retry.

A software reset also resets CAP_SEL. The existing probe recovery path
reapplies the configured crystal load after reset. Remember the
resolved CAP_SEL value when configuring the load capacitance and
restore it after runtime software resets as well.

Do not preserve other RTC register contents across recovery. A reset is
only performed when Control_1 is invalid or cannot be brought into the
expected state, so the previous RTC state should not be relied upon.

Assisted-by: ChatGPT:GPT-5.6-Sol
Signed-off-by: Albin Söderqvist <albin@albinutils.se>
---
 drivers/rtc/rtc-pcf85063.c | 71 ++++++++++++++++++++++++++++++++++++--
 1 file changed, 69 insertions(+), 2 deletions(-)

diff --git a/drivers/rtc/rtc-pcf85063.c b/drivers/rtc/rtc-pcf85063.c
index 1a4ca3d066ba..41291de53b5a 100644
--- a/drivers/rtc/rtc-pcf85063.c
+++ b/drivers/rtc/rtc-pcf85063.c
@@ -70,11 +70,26 @@ struct pcf85063_config {
 struct pcf85063 {
 	struct rtc_device	*rtc;
 	struct regmap		*regmap;
+	u8			ctrl1_cap_sel;
 #ifdef CONFIG_COMMON_CLK
 	struct clk_hw		clkout_hw;
 #endif
 };
 
+static int pcf85063_sw_reset(struct pcf85063 *pcf85063)
+{
+	int ret;
+
+	ret = regmap_write(pcf85063->regmap, PCF85063_REG_CTRL1,
+			   PCF85063_REG_CTRL1_SWR);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(pcf85063->regmap, PCF85063_REG_CTRL1,
+				  PCF85063_REG_CTRL1_CAP_SEL,
+				  pcf85063->ctrl1_cap_sel);
+}
+
 static int pcf85063_rtc_read_time(struct device *dev, struct rtc_time *tm)
 {
 	struct pcf85063 *pcf85063 = dev_get_drvdata(dev);
@@ -113,9 +128,26 @@ static int pcf85063_rtc_read_time(struct device *dev, struct rtc_time *tm)
 static int pcf85063_rtc_set_time(struct device *dev, struct rtc_time *tm)
 {
 	struct pcf85063 *pcf85063 = dev_get_drvdata(dev);
+	unsigned int ctrl1;
+	bool retried = false;
 	int rc;
 	u8 regs[7];
 
+	rc = regmap_read(pcf85063->regmap, PCF85063_REG_CTRL1, &ctrl1);
+	if (rc)
+		return rc;
+
+	if (ctrl1 & PCF85063_REG_CTRL1_READ_ZERO_MASK) {
+		dev_warn(dev,
+			 "invalid Control_1 value 0x%02x, resetting before time update\n",
+			 ctrl1);
+
+		rc = pcf85063_sw_reset(pcf85063);
+		if (rc)
+			return rc;
+	}
+
+retry:
 	/*
 	 * to accurately set the time, reset the divider chain and keep it in
 	 * reset state until all time/date registers are written
@@ -157,8 +189,42 @@ static int pcf85063_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	 * the register space is different between the PCF85063TP and
 	 * PCF85063A devices.  The rollover point can not be used.
 	 */
-	return regmap_update_bits(pcf85063->regmap, PCF85063_REG_CTRL1,
-				  PCF85063_REG_CTRL1_STOP, 0);
+	rc = regmap_update_bits(pcf85063->regmap, PCF85063_REG_CTRL1,
+				PCF85063_REG_CTRL1_STOP, 0);
+	if (rc)
+		return rc;
+
+	/*
+	 * Verify that set_time() established the expected control state.
+	 * If not, reset the device and retry the update once.
+	 */
+	rc = regmap_read(pcf85063->regmap, PCF85063_REG_CTRL1, &ctrl1);
+	if (rc)
+		return rc;
+
+	if (!(ctrl1 & (PCF85063_REG_CTRL1_READ_ZERO_MASK |
+		       PCF85063_REG_CTRL1_12_24 |
+		       PCF85063_REG_CTRL1_STOP |
+		       PCF85063_REG_CTRL1_EXT_TEST)))
+		return 0;
+
+	if (retried) {
+		dev_err(dev,
+			"unexpected Control_1 value 0x%02x after time update\n",
+			ctrl1);
+		return -EIO;
+	}
+
+	dev_warn(dev,
+		 "unexpected Control_1 value 0x%02x after time update, resetting and retrying\n",
+		 ctrl1);
+
+	rc = pcf85063_sw_reset(pcf85063);
+	if (rc)
+		return rc;
+
+	retried = true;
+	goto retry;
 }
 
 static int pcf85063_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *alrm)
@@ -367,6 +433,7 @@ static int pcf85063_load_capacitance(struct pcf85063 *pcf85063,
 		reg = PCF85063_REG_CTRL1_CAP_SEL;
 		break;
 	}
+	pcf85063->ctrl1_cap_sel = reg;
 
 	return regmap_update_bits(pcf85063->regmap, PCF85063_REG_CTRL1,
 				  PCF85063_REG_CTRL1_CAP_SEL, reg);
-- 
